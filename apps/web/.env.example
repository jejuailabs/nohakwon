# Browser-visible Firebase web application identifiers (not Admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Keep real credentials in .env.local / Vercel Environment Variables.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Production canonical origin, without a trailing slash. Leave empty for local dev.
APP_ORIGIN=

# AI extraction, generation and independent verification (server only).
OPENAI_API_KEY=
AI_MODEL=gpt-6-luna
AI_VERIFY_MODEL=gpt-6-luna

# Optional Toss billing integration. Keep test mode during development.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_MODE=test
ENABLE_LIVE_BILLING=false
# Base64-encoded random 32-byte key, required to encrypt billing keys.
BILLING_ENCRYPTION_KEY=

# Bearer secret for /api/cron; set the same value in the hosting scheduler.
CRON_SECRET=
