{
  "name": "nohakwon",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@nohakwon/web",
    "build": "npm run build --workspace=@nohakwon/web",
    "start": "npm run start --workspace=@nohakwon/web",
    "typecheck": "npm run typecheck --workspace=@nohakwon/web",
    "test": "tsx --test packages/core/src/*.test.ts apps/web/src/lib/*.test.ts"
  },
  "devDependencies": { "tsx": "^4.20.0" },
  "engines": { "node": ">=22.0.0" },
  "overrides": { "@firebase/app": "0.16.2", "@firebase/app-compat": "0.5.18" }
}
